# Copy to .env.local and supply values from your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Never use a NEXT_PUBLIC_ prefix or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
EXAM_SESSION_SECRET=replace-with-a-long-random-secret

# Optional contact address.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# Optional privileged importer configuration. Leave unset for normal app use.
# PRODUCTION_SUPABASE_URL=https://your-project.supabase.co
# PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
